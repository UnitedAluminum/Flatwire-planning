#!/bin/sh
# Flat Wire planning repo - pre-commit hook.
#
# Install:  cp tools/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# A generated file that nobody regenerates is worse than a hand-maintained one, because
# it still looks authoritative. This regenerates STATUS.md and stages it, so a commit can
# never leave the board disagreeing with what it is derived from.
#
# 9 Sep 2026, twice. First: StoryConsolidationMap.md became a hand-owned input to both
# boards, so it joined the list - it was absent, and an edit to it silently changed
# STATUS.md with no regeneration. Then: the stories moved into
# 10-requirements/features/<category>/<STREAM>/, so the `(^|/)tasks/FW-.*\.md$`
# alternative went from matching 204 files to matching ZERO and was removed. That is
# the same rot the note above describes, caught the same way - by counting matches
# against `git ls-files` rather than assuming.
set -e

PY=python
command -v python >/dev/null 2>&1 || PY=python3

# Only do the work when something that feeds the board actually changed.
#
# The path list below was repointed on 9 Sep 2026. Four of the seven alternatives named
# pre-29-Aug-re-tree paths (`Development/TaskBreakdown.md`, `Development/Phases/`,
# `FlatWireOpenQuestions.md`, `FlatWire_MasterSpecification.md`) and matched ZERO tracked
# files, so editing the backlog, a phase spec or any register regenerated nothing and ran
# no check. Keep these in step with fwtasks.py's TASK_DIRS / PHASE_DIR / BACKLOG /
# GAPS / QUESTIONS / DECIDED / MASTERSPEC / PLCSPEC constants.
if git diff --cached --name-only | grep -qE '^10-requirements/features/|^60-delivery/TaskBreakdown\.md$|^60-delivery/phases/|^90-registers/(Gaps|Questions|Decisions|TaskIdMap|StoryConsolidationMap)\.md$|^10-requirements/MasterSpecification\.md$|PLCTagSpecification\.md$|^tools/'; then
    "$PY" tools/build_status.py >/dev/null
    git add STATUS.md

    # The category board, once tools/build_features.py exists. Guarded so the hook keeps
    # working before that tool lands.
    if [ -f tools/build_features.py ]; then
        "$PY" tools/build_features.py >/dev/null
        git add FEATURES.md
        # The activity table is the ONLY status record once the task files are
        # retired, and its parser shipped broken. Round-trip it on every commit.
        if ! "$PY" tools/build_features.py --selftest >/tmp/fw_self.$$ 2>&1; then
            echo "pre-commit: build_features.py --selftest FAILED"
            cat /tmp/fw_self.$$
            rm -f /tmp/fw_self.$$
            exit 1
        fi
        rm -f /tmp/fw_self.$$
    fi

    # A story in the wrong category/stream folder. The placement rule and this check
    # are the same function, so they cannot disagree - see tools/storymap.py.
    if ! "$PY" tools/storymap.py --check >/tmp/fw_place.$$ 2>&1; then
        echo "pre-commit: storymap.py --check FAILED - a story is not where the rule puts it"
        cat /tmp/fw_place.$$
        rm -f /tmp/fw_place.$$
        exit 1
    fi
    rm -f /tmp/fw_place.$$

    if ! "$PY" tools/check_docs.py >/tmp/fw_check.$$ 2>&1; then
        echo "pre-commit: check_docs.py FAILED"
        cat /tmp/fw_check.$$
        rm -f /tmp/fw_check.$$
        echo
        echo "Fix the errors above, or commit with --no-verify if you know why."
        exit 1
    fi
    rm -f /tmp/fw_check.$$
fi

exit 0
